# ==============================================================================
# Client-side environment variables (exposed to browser via import.meta.env)
# ==============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_MEDIA_BASE_URL=

# ==============================================================================
# Server-side environment variables (Vercel Serverless Functions in /api)
# Set these in your Vercel Project Settings > Environment Variables.
# NEVER prefix with VITE_ and NEVER expose in frontend code.
# ==============================================================================
# Cloudflare R2 credentials (from Cloudflare dashboard > R2 > Manage R2 API Tokens)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
#
# Supabase credentials for server-side JWT verification in /api routes:
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
